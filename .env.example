# Server only. Never prefix either variable with NEXT_PUBLIC_.
# Required for Live catalog mint validation, holdings, and scaled quote units.
# A public endpoint can be used locally; a dedicated provider is recommended for deployment.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional for quote-only Live estimates when the upstream permits keyless access.
# Required for execution; keep it server-only and never expose it to the browser.
JUPITER_API_KEY=

# Optional account and cloud-plan support. These two values are intentionally public.
# Use a current sb_publishable_ key. Never put a secret/service_role key here.
# Run the Supabase migration and configure Auth redirect URLs before enabling accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring SMTP and verifying signup and recovery delivery.
# Only the exact value true enables email forms. Rebuild after changing this public flag.
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=false

# Server only. Required on Vercel for shared upstream request coordination.
# Use a current sb_secret_ key, never a publishable key. Apply all migrations in timestamp order; see docs/deployment.md.
SUPABASE_SECRET_KEY=
# Optional locally: exercise the same shared limiter used automatically on Vercel.
LOTLINE_SHARED_LIMITS=false

# Execution is an opt-in server feature. Leave false until the journal migration,
# Jupiter key, RPC, Supabase secret, and production reconciliation checks are ready.
LOTLINE_EXECUTION_ENABLED=false
LOTLINE_EXECUTION_MIGRATIONS_READY=false
# Keep false until 20260915090000_guest_execution_owner_index.sql is applied.
LOTLINE_EXECUTION_GUEST_MIGRATIONS_READY=false
# Keep false until 20260919090000_execution_integrity.sql is applied and checked.
LOTLINE_EXECUTION_INTEGRITY_MIGRATIONS_READY=false
LOTLINE_EXECUTION_REPOSITORY=supabase
LOTLINE_EXECUTION_VALIDATOR_READY=false
# Acknowledged validator version, after source/fixture/unsigned review:
# LOTLINE_EXECUTION_VALIDATOR_READY=jupiter-route-v2-raydium-clmm-v1
# Keep false until 20260920090000_execution_proof_immutability.sql is applied and checked.
LOTLINE_EXECUTION_PROOF_MIGRATIONS_READY=false
# Restricted launch only after issuer-access review. Never use a UI checkbox as eligibility proof.
LOTLINE_EXECUTION_ACCESS_POLICY=
# Comma-separated reviewed public wallet addresses (maximum20). Empty denies all purchases.
LOTLINE_EXECUTION_ALLOWED_WALLETS=

# Optional supplementary asset context. Server only; never prefix with NEXT_PUBLIC_.
# Get an assets:read key from https://app.tokens.xyz for approved API use.
# Disabled unless both this exact flag and a valid key are configured.
# See docs/tokens-enrichment.md for contract, timestamps, quotas and access terms.
TOKENS_XYZ_ENABLED=false
TOKENS_XYZ_API_KEY=
