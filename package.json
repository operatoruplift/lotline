    "@solana-program/token-2022": "0.17.0",
    "@solana/kit": "8.3.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@wallet-standard/app": "^1.1.1",
    "lucide-react": "1.45.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
